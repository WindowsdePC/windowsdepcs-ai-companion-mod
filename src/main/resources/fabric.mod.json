{
	"schemaVersion": 1,
	"id": "ai_companion",
	"version": "${version}",
	"name": "WindowsdePC's AI Companion Mod",
	"description": "AI-controlled players, dual configuration UIs, playable minigames, client enhancements, and optional gameplay features.",
	"authors": ["WindowsdePC"],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": ["com.example.ai_companion.AiCompanionMod"],
		"client": ["com.example.ai_companion.client.AiCompanionClient"],
		"modmenu": ["com.example.ai_companion.client.AiCompanionModMenuApi"],
		"voicechat": ["com.example.ai_companion.voice.AiCompanionVoicechatPlugin"]
	},
	"mixins": [
		"ai_companion.mixins.json",
		{
			"config": "ai_companion.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": ">=0.155.2"
	},
	"suggests": {
		"modmenu": "*",
		"eclipseui": "*",
		"cloth-config": "*",
		"voicechat": "*",
		"sophisticatedbackpacks": "*",
		"travelersbackpack": "*",
		"inventoryprofilesnext": "*"
	}
}
